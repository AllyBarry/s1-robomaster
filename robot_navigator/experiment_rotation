#!/bin/bash
# Forgetting-factor stress test.
#
# The formation rotates around its centre at ROTATION_RATE_DEG_PER_SEC.
# Beliefs stay alive throughout (no bundle restart), so the BLR's
# `forgetting` factor — set in config/belief.yaml — is what determines
# whether the learned gradient tracks the moving reward landscape or
# falls behind it.
#
# Workflow:
#   1. Edit `forgetting:` in config/belief.yaml (try 0.999, 0.99, 1.0).
#      docker compose build to bake the change into the image.
#   2. ./experiment_rotation
#   3. Watch /global_reward and /robot_*/belief/gradient_mag in RViz.
#      Compare across forgetting values.
#
# Reading the result:
#   - forgetting=1.0   → no decay; belief locks onto the initial
#                        landscape. As targets rotate away, gradient
#                        keeps pointing at the original positions and
#                        diverges from the rotating reward field.
#   - forgetting=0.999 → BLR half-life ~693 updates ≈ 35–70 s. Tracks
#                        slow rotations; visibly lags fast ones.
#   - forgetting=0.99  → half-life ~70 updates ≈ 3–7 s. Tracks faster
#                        but with more variance / noisier μ.
#
# Default rotation rate (5 deg/s = 0.087 rad/s) is one full revolution
# per ~72 s — slow enough that forgetting=0.999 should track it.

set -e
cd "$(dirname "$0")"

# ============================================================
# CONFIG — edit each line as needed
# ============================================================
FORMATION="line"                # line | triangle | circle
ROBOT_IDS="0,1,2"               # triangle requires exactly 3
SPACING="1.0"                   # m — line: neighbour spacing | triangle/circle: ring radius
CENTER_X="1.5"                  # m
CENTER_Y="1.5"                  # m

ROTATION_RATE_DEG_PER_SEC="1"   # 1 deg/s ≈ 1 full rev / 360 s
TOTAL_DURATION_SEC="300"        # 300 s = 300° rotation (≈ 5/6 of a full rev)

ASSIGNMENT="ordered"            # ordered | nearest
COLLISION="--no-collision"      # planner repulsion off — isolate the
                                # forgetting effect from collision noise
WAYPOINTS="--with-waypoints"
SETTLE_SEC=2
# ============================================================

NAV_IDS=$(echo "${ROBOT_IDS}" | tr ',' ' ')
N_ROBOTS=$(echo "${NAV_IDS}" | wc -w)

# Pre-flight
if [ "${FORMATION}" = "triangle" ] && [ "${N_ROBOTS}" -ne 3 ]; then
    echo "ERROR: triangle requires exactly 3 robots (got ${N_ROBOTS})." >&2
    exit 2
fi
case "${FORMATION}" in
    line|triangle|circle) ;;
    *) echo "ERROR: unknown formation '${FORMATION}'." >&2; exit 2 ;;
esac

# Convert deg/s → rad/s for the ROS parameter
ROTATION_RATE_RAD=$(awk -v d="${ROTATION_RATE_DEG_PER_SEC}" \
    'BEGIN{printf "%.6f", d*3.14159265358979/180.0}')

CLEANED=0
cleanup() {
    [ "${CLEANED}" = "1" ] && return
    CLEANED=1
    echo ""
    echo "=== Cleanup ==="
    # Navigators first (cmd_vel goes silent → bridge watchdog stops robots)
    for id in ${NAV_IDS}; do
        docker rm -f "robot_navigator_${id}" >/dev/null 2>&1 || true
    done
    docker rm -f belief_and_reward >/dev/null 2>&1 || true
    echo "Containers removed."
}
trap cleanup EXIT
trap 'cleanup; exit 130' INT TERM

publish_collision_toggle() {
    docker compose run --rm robot_navigator \
        ros2 topic pub --once /collision_avoidance_enabled \
        std_msgs/Bool "{data: $1}" >/dev/null 2>&1 || true
}

echo "=== Forgetting-factor test ==="
echo "    formation:    ${FORMATION} (spacing ${SPACING}, centre ${CENTER_X},${CENTER_Y})"
echo "    rotation:     ${ROTATION_RATE_DEG_PER_SEC} deg/s = ${ROTATION_RATE_RAD} rad/s"
echo "    duration:     ${TOTAL_DURATION_SEC} s"
echo "    forgetting:   set in config/belief.yaml (rebuild image to apply)"
echo ""

echo "=== Starting navigators for: ${NAV_IDS} ==="
./run_navigator.sh ${NAV_IDS}

echo ""
echo "=== Launching bundle with rotation_rate=${ROTATION_RATE_RAD} rad/s ==="
# Pass --duration matching the experiment so trajectory_logger captures
# the full rotation window — the script default of 100s would truncate.
./run_belief_and_reward.sh \
    ${COLLISION} \
    --robots "${ROBOT_IDS}" \
    --formation "${FORMATION}" \
    --spacing "${SPACING}" \
    --center-x "${CENTER_X}" \
    --center-y "${CENTER_Y}" \
    --assignment "${ASSIGNMENT}" \
    ${WAYPOINTS} \
    --rotation-rate "${ROTATION_RATE_RAD}" \
    --duration "${TOTAL_DURATION_SEC}"

if [ "${COLLISION}" = "--collision" ]; then
    sleep "${SETTLE_SEC}"
    publish_collision_toggle "true"
fi

echo ""
echo "=== Bundle running for ${TOTAL_DURATION_SEC}s ==="
echo "    Watch:  ros2 topic echo /global_reward"
echo "    RViz:   /robot_0/belief/gradient_mag (should rotate with targets if forgetting works)"
echo ""
# run_belief_and_reward.sh now blocks on `docker wait` until the bundle
# exits (trajectory_logger's on_exit=Shutdown cascades at --duration).
# Don't double-sleep here — that would idle for another full duration
# while the bundle is already gone.

echo "=== Done ==="
