<?xml version="1.0"?>
<package format="3">
  <name>rpi_camera_streamer</name>
  <version>0.0.1</version>
  <description>Camera streaming node for Raspberry Pi — publishes raw IR images over ROS topics</description>

  <maintainer email="you@example.com">you</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>openni2_camera</exec_depend>
  <exec_depend>v4l2_camera</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
